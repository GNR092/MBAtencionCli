{
    "name": "canva/hbd",
    "description": "Happy Birthday Canvas Module - Editor visual drag-drop + envío automático de correos de cumpleaños",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gener Can",
            "email": "gener.can@mbsignature.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Canva\\HBD\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Canva\\HBD\\HbdServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0"
    }
}
